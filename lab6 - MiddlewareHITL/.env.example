# Model (same as the CLI lab)
# OLLAMA / provider keys as needed for init_chat_model

# LangSmith (same keys as lab5 — load before LangChain imports)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=ai-class-lab-3

# Slack interactive HITL
# 1. Create a Slack app → OAuth & Permissions → Bot Token Scopes:
#    chat:write, chat:write.public (if posting to public channels without join)
# 2. Install to workspace → copy Bot User OAuth Token
# 3. Basic Information → Signing Secret
# 4. Interactivity & Shortcuts → enable → Request URL:
#    https://<your-ngrok-host>/slack/interactions
# 5. Invite the bot to the channel, then paste the channel ID below

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C0123456789
